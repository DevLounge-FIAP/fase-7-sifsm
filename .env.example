# ==========================================
# Configuração de Ambiente (.env.example)
# Renomeie para .env e preencha seus valores
# ==========================================

# Banco utilizado: oracle | sqlite
DB_ENGINE=oracle

# Oracle (credenciais da FIAP de cada membro)
ORACLE_USER=seu_rm
ORACLE_PASSWORD=sua_senha
ORACLE_DSN=host:porta/servico

# SQLite (alternativa local, usada se DB_ENGINE=sqlite)
SQLITE_PATH=aurora_siger.db
